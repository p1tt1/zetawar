{:site-title           "Zetawar"
 :author              "Zetawar"
 :description         "A turn based strategy game and AI platform"
 :site-url            "https://www.zetawar.com/"
 :post-root           "posts"
 :page-root           "pages"
 :post-root-uri       "blog"
 :page-root-uri       ""
 :tag-root-uri        "tags"
 :author-root-uri     "authors"
 :blog-prefix         ""
 :rss-name            "feed.xml"
 :rss-filters         ["cryogen"]
 :recent-posts        3
 :post-date-format    "yyyy-MM-dd"
 :archive-group-format "yyyy MMMM"
 :sass-src            nil
 :sass-path           nil
 :theme               "blue"
 :resources           ["assets"]
 :keep-files          [".git"]
 :disqus?             false
 :disqus-shortname    ""
 :ignored-files       ["^\\.#.*" ".*\\.swp$"]
 :previews?           false
 :posts-per-page      5
 :blocks-per-preview  2
 :clean-urls          true
 :hide-future-posts?  true
 :klipse              {}
 :debug?              false
 
 ;; Custom renderers to match your existing site
 :page-renderer       'zetawar.views.site/render-page
 :post-renderer       'zetawar.views.site/render-blog-post
 :home-renderer       'zetawar.views.site/render-index
 :tag-renderer        'zetawar.views.site/render-blog-index
 
 ;; Custom metadata
 :environment         "dev"
 :prefix              ""}
